NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exactly 32 random bytes encoded as 64 hexadecimal characters. Keep backed up.
QR_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3000
# supabase uses Phone Auth and its configured SMS provider. webhook uses your phone adapter.
OTP_PROVIDER=supabase
# Set true only after configuring and testing real SMS delivery in Supabase.
PHONE_OTP_CONFIGURED=false
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
# Set only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Used by bootstrap script only; remove after provisioning.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Event administrator
# Optional real PostgreSQL integration test connection (disposable database only).
TEST_DATABASE_URL=
